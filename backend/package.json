{
  "name": "music-subscription-backend",
  "version": "1.0.0",
  "description": "AWS Music Subscription Web App - Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "create-tables": "node scripts/createTables.js",
    "load-data": "node scripts/loadMusicData.js",
    "upload-images": "node scripts/uploadImages.js",
    "seed-users": "node scripts/seedLoginData.js",
    "setup": "npm run create-tables && npm run load-data && npm run upload-images && npm run seed-users"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.525.0",
    "@aws-sdk/lib-dynamodb": "^3.525.0",
    "@aws-sdk/client-s3": "^3.525.0",
    "@aws-sdk/s3-request-presigner": "^3.525.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "axios": "^1.6.7",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
